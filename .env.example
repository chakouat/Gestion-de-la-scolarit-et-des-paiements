# ==============================================================================
# Configuration globale de l'environnement ZEN
# ==============================================================================

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=zen_db
DB_USERNAME=zen_user
DB_PASSWORD=zen_password
DB_ROOT_PASSWORD=zen_root_password

# Backend (Laravel)
APP_NAME=ZEN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
